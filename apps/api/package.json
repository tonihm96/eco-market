{
  "name": "@eco-market/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:seed": "bun run src/database/seed.ts",
    "email:dev": "email dev --dir ./src/emails --port 3001",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eco-market/shared": "workspace:*",
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/openapi": "^1.4.17",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "better-auth": "^1.7.27",
    "@better-auth/expo": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.32",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.39.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.0",
    "drizzle-kit": "^0.31.11",
    "react-email": "^6.11.16",
    "typescript": "~5.9.3"
  }
}
