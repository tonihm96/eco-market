# Server
SERVER_PORT=3333
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Better Auth
BETTER_AUTH_SECRET=change_me_with_a_long_random_string
BETTER_AUTH_URL=http://localhost:3333
# Deep link scheme used by the mobile app (apps/mobile/app.json "scheme")
MOBILE_APP_SCHEME=ecomarket

# Resend (optional: without it, e-mails are printed to the console)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google OAuth (optional: enabled only when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment gateway (optional: "fake" approves payments locally)
PAYMENT_GATEWAY=fake

# Database
DATABASE_URL=postgresql://eco_market:secretpassword@localhost:5432/eco_market
